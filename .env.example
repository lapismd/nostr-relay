# Copy this file to .env for the local/reference Compose stack. Never commit
# populated credentials. Values below are placeholders, not usable secrets.

LAPIS_RELAY_HOST=relay.example
LAPIS_RELAY_PORT=8281
LAPIS_GIT_PUBLIC_URL=https://relay.example

# Nostr secret key and its matching hexadecimal public key.
LAPIS_RELAY_SECRET=<64-character-hex-nostr-secret>
LAPIS_RELAY_OWNER_PUBKEY=<matching-64-character-hex-public-key>

# The value is inserted inside a TOML array. Keep each pubkey quoted and
# comma-separated, for example: '"pubkey-one","pubkey-two"'
LAPIS_RELAY_ADMIN_PUBKEYS='"<relay-admin-hex-pubkey>"'

LAPIS_WALGIT_RELAY_TOKEN=<independent-random-service-token>
LAPIS_WALGIT_WEBHOOK_SECRET=<independent-random-webhook-secret>
LAPIS_RUSTFS_ACCESS_KEY=<local-object-store-access-key>
LAPIS_RUSTFS_SECRET_KEY=<local-object-store-secret-key>

LAPIS_FORGE_WORKER_MODE=embedded
LAPIS_GITHUB_WORKER_INTERVAL=2s
LAPIS_GITHUB_RECONCILE_INTERVAL=5m
LAPIS_GITHUB_MAX_WEBHOOK_BYTES=4194304

# Required only with docker-compose.github.yml. Use absolute paths to files
# outside this repository.
LAPIS_GITHUB_APP_KEY_FILE=/absolute/path/to/github-app-private-key.pem
LAPIS_GITHUB_WEBHOOK_SECRET_FILE=/absolute/path/to/github-webhook-secret
LAPIS_GITHUB_BRIDGE_SECRET_FILE=/absolute/path/to/github-bridge-secret
