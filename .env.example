# Copy this file to .env for the local/reference Compose stack. Never commit
# populated credentials. Values below are placeholders, not usable secrets.

LAPIS_RELAY_HOST=relay.example
LAPIS_RELAY_PORT=8281
LAPIS_GIT_PUBLIC_URL=https://relay.example

# Nostr secret key and its matching hexadecimal public key.
LAPIS_RELAY_SECRET=<64-character-hex-nostr-secret>
LAPIS_RELAY_OWNER_PUBKEY=<matching-64-character-hex-public-key>

# The value is inserted inside a TOML array. Keep each pubkey quoted and
# comma-separated, for example: '"pubkey-one","pubkey-two"'
LAPIS_RELAY_ADMIN_PUBKEYS='"<relay-admin-hex-pubkey>"'

LAPIS_AGENTS_ENABLED=true
LAPIS_AGENTS_ALLOW_OWNER_AUTH=true
LAPIS_AGENTS_ENFORCE_CREDENTIAL_KINDS=true

LAPIS_WALGIT_RELAY_TOKEN=<independent-random-service-token>
LAPIS_WALGIT_WEBHOOK_SECRET=<independent-random-webhook-secret>

# Provider-neutral S3-compatible object storage. These defaults address the
# local RustFS service. Production uses the Cloudflare R2 values documented in
# spec/src/operations/deployment.md.
LAPIS_S3_ENDPOINT=http://rustfs:9000
LAPIS_S3_REGION=us-east-1
LAPIS_S3_BUCKET=lapis-walgit
LAPIS_S3_PREFIX=
LAPIS_S3_FORCE_PATH_STYLE=true
LAPIS_S3_ACCESS_KEY_ID=<local-object-store-access-key-id>
LAPIS_S3_SECRET_ACCESS_KEY=<local-object-store-secret-access-key>

LAPIS_FORGE_WORKER_MODE=embedded
LAPIS_GITHUB_WORKER_INTERVAL=2s
LAPIS_GITHUB_RECONCILE_INTERVAL=5m
LAPIS_GITHUB_MAX_WEBHOOK_BYTES=4194304

# Optional application auth. The base auth overlay mounts the master key;
# provider overlays mount their own OAuth secret. The master key file must
# contain a hex or base64 encoded 32-byte value. OAuth client IDs are public.
LAPIS_AUTH_ENABLED=false
LAPIS_AUTH_PUBLIC_URL=http://localhost:8281
LAPIS_AUTH_ALLOWED_BROWSER_ORIGINS='["http://community.localhost:5173"]'
LAPIS_AUTH_MASTER_KEY_VERSION=v1
LAPIS_AUTH_SESSION_LIFETIME=168h
LAPIS_AUTH_SESSION_IDLE=24h
LAPIS_AUTH_CHALLENGE_TTL=10m
LAPIS_AUTH_GITHUB_CLIENT_ID=
LAPIS_AUTH_GITHUB_CLIENT_SECRET_REF=
LAPIS_AUTH_GOOGLE_CLIENT_ID=
LAPIS_AUTH_GOOGLE_CLIENT_SECRET_REF=
LAPIS_AUTH_MASTER_KEY_FILE=/absolute/path/to/auth-master-key
LAPIS_AUTH_GITHUB_CLIENT_SECRET_FILE=/absolute/path/to/github-oauth-client-secret
LAPIS_AUTH_GOOGLE_CLIENT_SECRET_FILE=/absolute/path/to/google-oauth-client-secret

# Required only with docker-compose.github.yml. Use absolute paths to files
# outside this repository.
LAPIS_GITHUB_APP_KEY_FILE=/absolute/path/to/github-app-private-key.pem
LAPIS_GITHUB_WEBHOOK_SECRET_FILE=/absolute/path/to/github-webhook-secret
LAPIS_GITHUB_BRIDGE_SECRET_FILE=/absolute/path/to/github-bridge-secret
