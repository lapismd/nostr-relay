+// ---- arbitrary comparison ----------------------------------------------------
+
+/// Compare two immutable commits for PR review. This lives beside commit
+/// detail so there is still one Git object engine and one materialization
+/// policy. The initial endpoint requires a disk-cache host; remote-pack
+/// comparison can be added without changing this wire contract.
+async fn compare(
+    State(st): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Path((owner, repo_name)): Path<(String, String)>,
+    Query(q): Query<CompareQuery>,
+) -> Result<Response, ApiError> {
+    if !is_full_sha(&q.base) || !is_full_sha(&q.head) || q.base.len() != q.head.len() {
+        return Err(ApiError::BadRequest(
+            "base and head must be full same-format object IDs".into(),
+        ));
+    }
+    if q.mode != "direct" && q.mode != "merge-base" {
+        return Err(ApiError::BadRequest(
+            "mode must be direct or merge-base".into(),
+        ));
+    }
+    if q.max_files == 0 || q.max_files > 20_000 {
+        return Err(ApiError::BadRequest("max_files must be 1..=20000".into()));
+    }
+    if q.max_patch_bytes == 0 || q.max_patch_bytes > 64 * 1024 * 1024 {
+        return Err(ApiError::BadRequest(
+            "max_patch_bytes must be 1..=67108864".into(),
+        ));
+    }
+    run(
+        &st,
+        &headers,
+        &owner,
+        &repo_name,
+        Need::Objects,
+        None,
+        move |r| async move {
+            if r.remote().is_some() {
+                return Err(ApiError::ServiceUnavailable(
+                    "compare requires cache.mode=disk on this host".into(),
+                ));
+            }
+            // Full IDs are still peeled as commits: a blob or tree ID is not
+            // a valid comparison endpoint input.
+            for oid in [&q.base, &q.head] {
+                git(
+                    &r.local,
+                    vec![
+                        "rev-parse".into(),
+                        "--verify".into(),
+                        "--quiet".into(),
+                        "--end-of-options".into(),
+                        format!("{oid}^{{commit}}"),
+                    ],
+                )
+                .await?;
+            }
+            let requested_base = q.base.clone();
+            let (base, merge_base) = if q.mode == "merge-base" {
+                let output = git(
+                    &r.local,
+                    vec![
+                        "merge-base".into(),
+                        "--all".into(),
+                        q.base.clone(),
+                        q.head.clone(),
+                    ],
+                )
+                .await
+                .map_err(|_| ApiError::UnprocessableEntity("unrelated histories".into()))?;
+                let mut bases: Vec<String> = String::from_utf8_lossy(&output)
+                    .lines()
+                    .map(str::trim)
+                    .filter(|line| is_full_sha(line))
+                    .map(str::to_string)
+                    .collect();
+                bases.sort();
+                let base = bases
+                    .into_iter()
+                    .next()
+                    .ok_or_else(|| ApiError::UnprocessableEntity("unrelated histories".into()))?;
+                (base.clone(), Some(base))
+            } else {
+                (requested_base, None)
+            };
+            let range = [base.clone(), q.head.clone()];
+            let names = compare_git(&r.local, "--name-status", &range).await?;
+            let names = parse_compare_names(&names);
+            if names.len() > q.max_files {
+                return Err(ApiError::PayloadTooLarge);
+            }
+            let stats = compare_git(&r.local, "--numstat", &range).await?;
+            let stats = parse_compare_stats(&stats);
+            let files = names
+                .into_iter()
+                .map(|(status, old_path, path)| {
+                    let (additions, deletions, binary) =
+                        stats.get(&path).copied().unwrap_or((0, 0, false));
+                    CompareFile {
+                        path,
+                        old_path,
+                        status,
+                        additions,
+                        deletions,
+                        binary,
+                    }
+                })
+                .collect();
+            let patch = git(
+                &r.local,
+                vec![
+                    "diff".into(),
+                    "--binary".into(),
+                    "--full-index".into(),
+                    "-M".into(),
+                    "--no-color".into(),
+                    "--no-ext-diff".into(),
+                    base.clone(),
+                    q.head.clone(),
+                    "--".into(),
+                ],
+            )
+            .await?;
+            if patch.len() > q.max_patch_bytes {
+                return Err(ApiError::PayloadTooLarge);
+            }
+            let result = CompareResult {
+                base,
+                head: q.head,
+                merge_base,
+                files,
+                patch: String::from_utf8_lossy(&patch).into_owned(),
+            };
+            Ok(Rendered::json(json_bytes(&result), IMMUTABLE, None))
         },
     )
     .await
 }
