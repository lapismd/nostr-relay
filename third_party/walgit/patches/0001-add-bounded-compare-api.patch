+async fn compare_git(
+    local: &walgit_git::LocalRepo,
+    format: &str,
+    range: &[String; 2],
+) -> Result<Vec<u8>, ApiError> {
+    git(
+        local,
+        vec![
+            "diff".into(),
+            format.into(),
+            "-z".into(),
+            "-M".into(),
+            "--no-color".into(),
+            "--no-ext-diff".into(),
+            range[0].clone(),
+            range[1].clone(),
+            "--".into(),
+        ],
+    )
+    .await
+}
+
+fn parse_compare_names(bytes: &[u8]) -> Vec<(String, Option<String>, String)> {
+    let mut fields = bytes
+        .split(|byte| *byte == 0)
+        .filter(|field| !field.is_empty());
+    let mut files = Vec::new();
+    while let Some(raw_status) = fields.next() {
+        let kind = String::from_utf8_lossy(raw_status)
+            .chars()
+            .next()
+            .unwrap_or('X');
+        let status = match kind {
+            'A' => "added",
+            'D' => "deleted",
+            'M' => "modified",
+            'R' => "renamed",
+            'C' => "copied",
+            'T' => "type_changed",
+            'U' => "unmerged",
+            _ => "unknown",
+        }
+        .to_string();
+        let Some(first) = fields.next() else { break };
+        let first = String::from_utf8_lossy(first).into_owned();
+        if kind == 'R' || kind == 'C' {
+            let Some(second) = fields.next() else { break };
+            files.push((
+                status,
+                Some(first),
+                String::from_utf8_lossy(second).into_owned(),
+            ));
+        } else {
+            files.push((status, None, first));
+        }
+    }
+    files
+}
+
+fn parse_compare_stats(bytes: &[u8]) -> std::collections::HashMap<String, (i64, i64, bool)> {
+    let mut fields = bytes
+        .split(|byte| *byte == 0)
+        .filter(|field| !field.is_empty());
+    let mut stats = std::collections::HashMap::new();
+    while let Some(record) = fields.next() {
+        let columns: Vec<&[u8]> = record.splitn(3, |byte| *byte == b'\t').collect();
+        if columns.len() != 3 {
+            continue;
+        }
+        let binary = columns[0] == b"-" || columns[1] == b"-";
+        let additions = if binary {
+            0
+        } else {
+            String::from_utf8_lossy(columns[0]).parse().unwrap_or(0)
+        };
+        let deletions = if binary {
+            0
+        } else {
+            String::from_utf8_lossy(columns[1]).parse().unwrap_or(0)
+        };
+        // Rename numstat uses an empty path followed by old and new NUL fields.
+        let path = if columns[2].is_empty() {
+            let _old = fields.next();
+            fields.next()
+        } else {
+            Some(columns[2])
+        };
+        if let Some(path) = path {
+            stats.insert(
+                String::from_utf8_lossy(path).into_owned(),
+                (additions, deletions, binary),
+            );
+        }
+    }
+    stats
+}
